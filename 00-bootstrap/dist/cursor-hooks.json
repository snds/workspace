{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "$HOME/.claude/hooks/cursor-sessionstart.sh"
      },
      {
        "command": "$HOME/.config/snds-workspace/bin/ws-hook sweep --host cursor",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "$HOME/.config/snds-workspace/bin/ws-hook --host cursor --event pre-tool",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "$HOME/.config/snds-workspace/bin/ws-hook --host cursor --event pre-tool",
        "matcher": "Shell|Write",
        "timeout": 5
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "$HOME/.config/snds-workspace/bin/ws-hook --host cursor --event pre-tool",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": "$HOME/.config/snds-workspace/bin/ws-hook --host cursor --event post-tool",
        "timeout": 5
      }
    ],
    "afterShellExecution": [
      {
        "command": "$HOME/.config/snds-workspace/bin/ws-hook --host cursor --event post-tool",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "$HOME/.config/snds-workspace/bin/ws-hook --host cursor --event stop",
        "timeout": 5
      }
    ]
  }
}
