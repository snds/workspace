{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/workspace-sessionstart.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/workspace-reassert.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/workspace-audit.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "WS_CLAUDE_OVERLAY": "v4",
    "GH_CONFIG_DIR": "~/.config/snds-workspace/gh-claude",
    "GIT_CONFIG_COUNT": "15",
    "GIT_CONFIG_KEY_0": "includeIf.hasconfig:remote.*.url:git@github.com:snds/**.path",
    "GIT_CONFIG_VALUE_0": "~/.config/snds-workspace/git/claude-identity.inc",
    "GIT_CONFIG_KEY_1": "includeIf.hasconfig:remote.*.url:git@github-work:snds/**.path",
    "GIT_CONFIG_VALUE_1": "~/.config/snds-workspace/git/claude-identity.inc",
    "GIT_CONFIG_KEY_2": "includeIf.hasconfig:remote.*.url:https://github.com/snds/**.path",
    "GIT_CONFIG_VALUE_2": "~/.config/snds-workspace/git/claude-identity.inc",
    "GIT_CONFIG_KEY_3": "includeIf.hasconfig:remote.*.url:ssh://git@github.com/snds/**.path",
    "GIT_CONFIG_VALUE_3": "~/.config/snds-workspace/git/claude-identity.inc",
    "GIT_CONFIG_KEY_4": "url.https://github.com/snds/.insteadOf",
    "GIT_CONFIG_VALUE_4": "git@github-work:snds/",
    "GIT_CONFIG_KEY_5": "url.https://github.com/snds/.insteadOf",
    "GIT_CONFIG_VALUE_5": "git@github.com:snds/",
    "GIT_CONFIG_KEY_6": "url.https://github.com/snds/.insteadOf",
    "GIT_CONFIG_VALUE_6": "ssh://git@github.com/snds/",
    "GIT_CONFIG_KEY_7": "credential.https://github.com.helper",
    "GIT_CONFIG_VALUE_7": "",
    "GIT_CONFIG_KEY_8": "credential.https://github.com.helper",
    "GIT_CONFIG_VALUE_8": "!gh auth git-credential",
    "GIT_CONFIG_KEY_9": "url.claude-is-personal-only-blocked-employer-remote://.insteadOf",
    "GIT_CONFIG_VALUE_9": "git@github-work:cpes-software/",
    "GIT_CONFIG_KEY_10": "url.claude-is-personal-only-blocked-employer-remote://.insteadOf",
    "GIT_CONFIG_VALUE_10": "git@github.com:cpes-software/",
    "GIT_CONFIG_KEY_11": "url.claude-is-personal-only-blocked-employer-remote://.insteadOf",
    "GIT_CONFIG_VALUE_11": "https://github.com/cpes-software/",
    "GIT_CONFIG_KEY_12": "url.claude-is-personal-only-blocked-employer-remote://.insteadOf",
    "GIT_CONFIG_VALUE_12": "git@bitbucket.org:centricsoftware/",
    "GIT_CONFIG_KEY_13": "url.claude-is-personal-only-blocked-employer-remote://.insteadOf",
    "GIT_CONFIG_VALUE_13": "https://bitbucket.org/centricsoftware/",
    "GIT_CONFIG_KEY_14": "url.claude-is-personal-only-blocked-employer-remote://.insteadOf",
    "GIT_CONFIG_VALUE_14": "ssh://git@bitbucket.org/centricsoftware/"
  }
}
