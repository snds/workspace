{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/workspace-sessionstart.sh",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/snds-workspace/bin/ws-hook env-file --host claude-code",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/workspace-reassert.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/workspace-audit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__terminal__run_in_terminal|mcp__workspace__bash|Write|Edit|MultiEdit|NotebookEdit|mcp__workspace-fs__.*|mcp__claude-in-chrome__.*|mcp__computer-use__.*|mcp__linear-c8__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/snds-workspace/bin/ws-hook --host claude-code --event pre-tool",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
