#!/bin/sh
L="$HOME/.config/snds-workspace/lib/current/09-tools/gh_route.py"
# git-credential-ws — the workspace GitHub route for git (snds-workspace). Byte-stable; do not edit.
# git calls it as a credential helper; the pinned gh_route.py answers with the repo owner's gh token.
# With no pin it answers nothing, so git falls through to its next helper.
command -v python3 >/dev/null 2>&1 || exit 0
[ -f "$L" ] || exit 0
exec env -u PYTHONPATH -u PYTHONHOME -u PYTHONSTARTUP -u PYTHONINSPECT -u PYTHONUSERBASE python3 "$L" credential "$@"
