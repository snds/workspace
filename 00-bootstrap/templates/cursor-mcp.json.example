{
  "_comment": "Copy to ~/.cursor/mcp.json. Expand HOME in MCP_REMOTE_CONFIG_DIR — Cursor env does not expand ~. No secrets in this file; Linear OAuth tokens land in that dir. See 02-shared-references/capability-registry.md. Do not commit ~/.cursor/mcp.json. Voyager-2.local: personal only. Work MBP: also add linear-c8 with ~/.mcp-auth/linear-c8.",
  "mcpServers": {
    "linear-personal": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/mcp"],
      "env": {
        "MCP_REMOTE_CONFIG_DIR": "/Users/YOU/.mcp-auth/linear-personal"
      }
    }
  }
}
