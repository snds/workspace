{
  "env": {
    "EDITOR": "vi",
    "GIT_AUTHOR_NAME": "Pat Sample",
    "GIT_AUTHOR_EMAIL": "pat-sample@example.invalid",
    "GIT_COMMITTER_NAME": "Pat Sample",
    "GIT_COMMITTER_EMAIL": "pat-sample@example.invalid",
    "WS_CLAUDE_OVERLAY": "v1"
  },
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "$HOME/.claude/hooks/workspace-sessionstart.sh", "timeout": 15}]},
      {"hooks": [{"type": "command", "command": "$HOME/bin/my-own-hook.sh"}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "$HOME/.claude/hooks/workspace-reassert.sh", "timeout": 5}]}
    ]
  },
  "model": "fixture"
}
