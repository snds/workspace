{
  "id": "n-km2e8vdf",
  "name": "check-secrets",
  "description": "Scans tracked files for well-known secret shapes and exits 1 on any hit. The walls run checks persona content against its baseline, part of walls.persona-content.",
  "language": "python",
  "entry": "check-secrets.py",
  "runtime": "python>=3.10",
  "safety": "read-only",
  "network": false,
  "implements": [
    "secrets.none"
  ],
  "run": {
    "check": [],
    "walls": {
      "args": [
        "--class",
        "employer-substance",
        "--baseline-check"
      ],
      "description": "Persona content against the committed baseline"
    },
    "walls-report": {
      "args": [
        "--class",
        "employer-substance",
        "--report",
        "--json"
      ],
      "output": "json",
      "description": "Every persona-content hit, as JSON"
    },
    "write-baseline": {
      "args": [
        "--class",
        "employer-substance",
        "--write-baseline"
      ],
      "safety": "writes-workspace",
      "description": "Rewrites the committed baseline"
    },
    "self-test": {
      "args": [
        "--self-test"
      ],
      "description": "Writes only to a temporary folder"
    }
  },
  "output": "exit-code",
  "timeout_s": 120
}
