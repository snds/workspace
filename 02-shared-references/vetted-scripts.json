{
  "schema_version": 1,
  "doc": "Vetted-script registry (DECISIONS-2 item 9). Blob hashes are taken at pin time into lib/<sha>/vetted.lock.json; this file carries none. Only the pinned copy is consulted, so an edit here takes effect after a human advances the pin. Each action runs only the argv shapes listed under `argv` (<ref> one plain ref name, <n> digits, <path> one non-option path).",
  "scripts": [
    {
      "id": "prune-our-branches",
      "path": "09-tools/prune-our-branches.py",
      "action_classes": [
        "meta",
        "housekeeping"
      ],
      "actions": {
        "fetch": "meta",
        "pr-list": "meta",
        "switch-default": "housekeeping",
        "ff-default": "housekeeping",
        "branch-delete": "housekeeping",
        "remote-branch-delete": "housekeeping",
        "worktree-remove": "housekeeping"
      },
      "needs_employer_gh": true,
      "approved": "Sean 2026-09-22, DECISIONS-2 item 9 confirmation",
      "argv": {
        "fetch": [
          [
            "git",
            "fetch",
            "origin",
            "<ref>"
          ],
          [
            "git",
            "fetch",
            "origin"
          ],
          [
            "git",
            "fetch",
            "--prune",
            "origin"
          ]
        ],
        "pr-list": [
          [
            "gh",
            "pr",
            "list",
            "--state",
            "<ref>",
            "--author",
            "@me",
            "--limit",
            "<n>",
            "--json",
            "number,headRefName,headRefOid,baseRefName,isCrossRepository,state"
          ],
          [
            "gh",
            "pr",
            "list",
            "--state",
            "<ref>",
            "--limit",
            "<n>",
            "--json",
            "number,headRefName,headRefOid,baseRefName,isCrossRepository,state"
          ],
          [
            "gh",
            "pr",
            "list",
            "--state",
            "<ref>",
            "--base",
            "<ref>",
            "--limit",
            "<n>",
            "--json",
            "number"
          ]
        ],
        "switch-default": [
          [
            "git",
            "switch",
            "<ref>"
          ]
        ],
        "ff-default": [
          [
            "git",
            "merge",
            "--ff-only",
            "<ref>"
          ]
        ],
        "branch-delete": [
          [
            "git",
            "branch",
            "-D",
            "<ref>"
          ],
          [
            "git",
            "branch",
            "-d",
            "<ref>"
          ]
        ],
        "remote-branch-delete": [
          [
            "git",
            "push",
            "origin",
            "--delete",
            "<ref>"
          ]
        ],
        "worktree-remove": [
          [
            "git",
            "worktree",
            "remove",
            "<path>"
          ]
        ]
      }
    },
    {
      "id": "pr-desk",
      "path": "09-tools/pr-desk.py",
      "action_classes": [
        "content-read",
        "publish",
        "merge"
      ],
      "actions": {
        "status": "content-read",
        "checks": "content-read",
        "logs": "content-read",
        "comments": "content-read",
        "merge": "merge",
        "review-comments": "content-read",
        "alerts": "content-read",
        "push": "publish",
        "create": "publish"
      },
      "needs_employer_gh": true,
      "approved": "Sean 2026-10-12: read PRs, their CI and comments, and merge after his review (\"I would be the engineer that would be reviewing this\"); Sean 2026-10-13: push feature branches and open PRs in the two repos in scope",
      "argv": {
        "status": [
          [
            "gh",
            "pr",
            "view",
            "<n>",
            "--json",
            "number,title,url,state,isDraft,mergeable,mergeStateStatus,reviewDecision,headRefName,baseRefName,statusCheckRollup"
          ]
        ],
        "checks": [
          [
            "gh",
            "pr",
            "checks",
            "<n>",
            "--json",
            "name,state,bucket,link,workflow"
          ]
        ],
        "logs": [
          [
            "gh",
            "run",
            "view",
            "<ref>",
            "--log-failed"
          ]
        ],
        "comments": [
          [
            "gh",
            "pr",
            "view",
            "<n>",
            "--json",
            "comments,reviews"
          ]
        ],
        "merge": [
          [
            "gh",
            "pr",
            "merge",
            "<n>",
            "--squash"
          ],
          [
            "gh",
            "pr",
            "merge",
            "<n>",
            "--merge"
          ],
          [
            "gh",
            "pr",
            "merge",
            "<n>",
            "--rebase"
          ]
        ],
        "review-comments": [
          [
            "gh",
            "api",
            "--paginate",
            "repos/{owner}/{repo}/pulls/<n>/comments"
          ]
        ],
        "alerts": [
          [
            "gh",
            "api",
            "--paginate",
            "repos/{owner}/{repo}/code-scanning/alerts?ref=refs/pull/<n>/merge&state=open"
          ]
        ],
        "push": [
          [
            "git",
            "-c",
            "credential.helper=",
            "-c",
            "credential.helper=!gh auth git-credential",
            "push",
            "-u",
            "origin",
            "<ref>"
          ],
          [
            "git",
            "-c",
            "credential.helper=",
            "-c",
            "credential.helper=!gh auth git-credential",
            "push",
            "--dry-run",
            "-u",
            "origin",
            "<ref>"
          ]
        ],
        "create": [
          [
            "gh",
            "pr",
            "create",
            "--base",
            "<ref>",
            "--head",
            "<ref>",
            "--title",
            "<text>",
            "--body-file",
            "<path>"
          ]
        ]
      }
    }
  ]
}
